{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "types": [
      "node",
    ],
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": [
    "src/**/*",
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/test-utils/**/*",
  ],
  "references": [
    {
      "path": "../common"
    },
  ],
}